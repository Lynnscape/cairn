{
	"name": "web",
	"private": true,
	"version": "1.0.2",
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"packageManager": "pnpm@10.33.3",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo '' && lefthook install || echo 'lefthook hooks not registered (skip in CI is fine)'",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen:icons": "node scripts/generate-icons.mjs",
		"gen:licenses": "node scripts/gen-licenses.mjs",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:pwa": "playwright test -c playwright.pwa.config.ts",
		"test:e2e:ui": "playwright test --ui"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-static": "^3.0.11",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@testing-library/jest-dom": "^8.0.0",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^5.1.1",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"happy-dom": "^21.0.4",
		"lefthook": "^2.2.2",
		"msw": "^3.0.7",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"sharp": "^0.35.5",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"svelte-eslint-parser": "^1.12.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.74.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"dependencies": {
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/newsreader": "^5.3.0",
		"jszip": "^3.10.2"
	}
}
